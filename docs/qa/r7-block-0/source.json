      "endIndex": 25214,
      "tabId": "t.6cfgj0znk3o",
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false
    },
    {
      "text": "El sistema permitirá al usuario compartir información relevante de un evento mediante las aplicaciones externas de mensajería o redes disponibles en el dispositivo.",
      "startIndex": 25216,
      "endIndex": 25380,
      "tabId": "t.6cfgj0znk3o",
      "namedStyleType": "NORMAL_TEXT",
