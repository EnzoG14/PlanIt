  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "0.25.0",
    "playwright-chromium": "1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "image-size": "2.0.4"
  }
